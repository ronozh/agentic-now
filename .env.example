DATABASE_URL=postgresql://postgres:postgres@localhost:5433/agentic
OLLAMA_BASE_URL=http://localhost:11434/v1
CHAT_MODEL=qwen3:4b-instruct  # dev speed; qwen3:8b for quality comparisons
EMBED_MODEL=nomic-embed-text
CHAT_THINKING=false
PYDANTIC_AI_NO_BANNER=1
LOG_LEVEL=INFO
# Langfuse (local dev keys created by infra/langfuse/docker-compose.override.yml)
LANGFUSE_PUBLIC_KEY=pk-lf-agentic-now-local
LANGFUSE_SECRET_KEY=sk-lf-agentic-now-local
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_TIMEOUT=30  # seconds; default 5 drops spans when ClickHouse is busy
